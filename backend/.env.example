# backend/.env.example
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=lazanibetsileo
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Maileroo API (envoi d'emails transactionnels) — canal principal.
# Créer une clé dans Maileroo → Domains → Sending Keys.
MAILEROO_API_KEY=roo_change-me
# Adresse d'expédition : domaine vérifié sur https://maileroo.com
MAILEROO_SENDER_EMAIL=noreply@lazani-betsileo.mg
MAILEROO_SENDER_NAME=LAZAN'I BETSILEO

# Resend API pour l'envoi d'emails (repli si MAILEROO_API_KEY est absente)
RESEND_API_KEY=re_change-me
# Domaine vérifié sur https://resend.com/domains (sinon repli automatique
# sur RESEND_SANDBOX_SENDER).
RESEND_SENDER_EMAIL=noreply@lazani-betsileo.mg
RESEND_SANDBOX_SENDER=onboarding@resend.dev

# eSMS Afrique API pour l'envoi de SMS (sms.esmsafrica.io)
# Sender ID approuvé via /sender-ids, route Madagascar = ESMS_MG.
ESMS_API_KEY=esms_live_change-me
ESMS_SENDER_ID=eSMS

# Envoi réel des codes OTP même en DEBUG (désactivé automatiquement en tests).
OTP_ENVOI_REEL=True

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
